
// ---- appended by packages/mpv.cmake (libass removed) ----
// Replacements for the functions osd_libass.c used to provide.
// Without libass there is no OSD text/overlay rendering, so these are no-ops.

void osd_set_external(struct osd_state *osd, struct osd_external_ass *ov)
{
}

void osd_set_external_remove_owner(struct osd_state *osd, void *owner)
{
}

void osd_get_text_size(struct osd_state *osd, int *out_screen_h, int *out_font_h)
{
    // Non-zero values so callers that divide by the font height stay safe.
    *out_screen_h = 720;
    *out_font_h = 55;
}

void osd_get_function_sym(char *buffer, size_t buffer_size, int osd_function)
{
    if (buffer_size)
        buffer[0] = '\0';
}

void osd_mangle_ass(bstr *dst, const char *in, bool replace_newlines)
{
    bstr_xappend(NULL, dst, bstr0(in));
}
