+
+static int set_aes_key_arg(URLContext *h, uint8_t **buf, int *buf_len,
+                           uint8_t *default_buf, int default_buf_len)
+{
+    if (!*buf_len) {
+        if (default_buf_len != 16 && default_buf_len != 24 && default_buf_len != 32) {
+            av_log(h, AV_LOG_ERROR, "invalid decryption key size (%d bytes)\n", default_buf_len);
+            return AVERROR(EINVAL);
+        }
+        *buf = av_memdup(default_buf, default_buf_len);
+        if (!*buf)
+            return AVERROR(ENOMEM);
+        *buf_len = default_buf_len;
+    } else if (*buf_len != 16 && *buf_len != 24 && *buf_len != 32) {
+        av_log(h, AV_LOG_ERROR, "invalid decryption key size (%d bytes)\n", *buf_len);
+        return AVERROR(EINVAL);
+    }
+    return 0;
+}
+
+/* ECB has no IV. Allocate a zeroed buffer so seek code never touches NULL. */
+static int crypto_ecb_dummy_iv(CryptoContext *c)
+{
+    if (!c->decrypt_iv) {
+        c->decrypt_iv = av_mallocz(BLOCKSIZE);
+        if (!c->decrypt_iv)
+            return AVERROR(ENOMEM);
+        c->decrypt_ivlen = BLOCKSIZE;
+    }
+    return 0;
+}
